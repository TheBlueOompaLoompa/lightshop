; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lightshop"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "C#")
boot_splash/show_image=false
config/icon="uid://b5uty8wcctkn0"

[autoload]

uuid="*res://addons/uuid/uuid.gd"
GL="*res://scripts/gl.gd"
Log="*res://scripts/log.gd"
Net="*res://scripts/net/manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/subwindows/embed_subwindows=false

[dotnet]

project/assembly_name="Lightshop"

[editor_plugins]

enabled=PackedStringArray("res://addons/GDContextMenu/plugin.cfg", "res://addons/Gizmo3DScript/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg", "res://addons/tnowe_extra_controls/plugin.cfg", "res://addons/uuid/plugin.cfg")

[filesystem]

import/blender/enabled=false

